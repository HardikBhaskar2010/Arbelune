{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arbelune",
  "version": "0.4.1",
  "identifier": "com.arbelune.browser",
  "build": {
    "frontendDist": "../src-ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Arbelune — Developer Browser",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' ws://127.0.0.1:*"
    }
  },
  "plugins": {}
}
