  "scripts": {
    "dev": "npm --prefix src-ui run dev",
    "build": "npm --prefix src-ui run build",
    "lint:ui": "npm --prefix src-ui run lint",
    "test:cargo": "cargo test --workspace",
    "check:clippy": "cargo clippy --workspace -- -D warnings",
    "fetch:cef": "python scripts/fetch-cef.py"
